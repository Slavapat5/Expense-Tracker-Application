<div class="card shadow-sm">
  <div class="card-body">

    <%= form_with(model: category, class: "row g-3") do |form| %>

      <% if category.errors.any? %>
        <div class="alert alert-danger">
          <h5><%= pluralize(category.errors.count, "error") %> prevented this category from being saved:</h5>
          <ul class="mb-0">
            <% category.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Category Name -->
      <div class="col-12">
        <%= form.label :name, "Category Name", class: "form-label" %>
        <%= form.text_field :name, class: "form-control", placeholder: "e.g. Food, Rent, Transport", required: true %>
      </div>

      <!-- Buttons -->
      <div class="col-12 d-flex justify-content-between mt-3">
        <%= link_to "Back", categories_path, class: "btn btn-outline-secondary" %>

        <%= form.submit (category.persisted? ? "Update Category" : "Create Category"),
                        class: "btn btn-primary" %>
      </div>

    <% end %>

  </div>
</div>
