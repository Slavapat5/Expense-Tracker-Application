<h1>Dashboard</h1>

<div class="summary-cards" style="display: flex; gap: 20px; margin-bottom: 30px;">
  <div class="card" style="padding: 15px; border: 1px solid #ccc; border-radius: 8px; width: 200px; text-align: center;">
    <h4>Total Spending</h4>
    <p><strong><%= number_to_currency(@total_spent) %></strong></p>
  </div>

  <div class="card" style="padding: 15px; border: 1px solid #ccc; border-radius: 8px; width: 200px; text-align: center;">
    <h4>Spending This Month</h4>
    <p><strong><%= number_to_currency(@month_spent) %></strong></p>
  </div>
</div>

<h3>Spending by Category</h3>
<div style="max-width: 350px; margin: 0 auto 40px auto;">
  <canvas id="categoryChart"></canvas>
</div>


<h3>Recent Transactions</h3>
<table border="1" cellpadding="5" cellspacing="0" style="border-collapse: collapse; width: 100%;">
  <thead>
    <tr>
      <th>Date</th>
      <th>Category</th>
      <th>Amount</th>
      <th>Note</th>
    </tr>
  </thead>
  <tbody>
    <% @recent_transactions.each do |t| %>
      <tr>
        <td><%= t.occurred_on %></td>
        <td><%= t.category.name %></td>
        <td><%= number_to_currency(t.amount) %></td>
        <td><%= t.note %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const ctx = document.getElementById('categoryChart').getContext('2d');
  const categoryChart = new Chart(ctx, {
    type: 'pie',
    data: {
      labels: <%= raw @spending_by_category.keys.to_json %>,
      datasets: [{
        data: <%= raw @spending_by_category.values.to_json %>,
        backgroundColor: [
          '#36A2EB', '#FF6384', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40'
        ],
      }]
    },
    options: {
      plugins: {
        legend: {
          position: 'bottom'
        }
      }
    }
  });
</script>
