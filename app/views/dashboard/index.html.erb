<% content_for :title, "Dashboard" %>

<!-- Force a full page load so DOMContentLoaded fires (helps with Turbo) -->
<meta name="turbo-visit-control" content="reload">

<div class="container">

  <h1 class="mb-4">Dashboard</h1>
  
  <div class="mb-3 text-end">
  <%= link_to "Refresh charts",
              dashboard_path,
              data: { turbo: false },
              class: "btn btn-outline-secondary btn-sm" %>
</div>

  <!-- Insights Section -->
  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5>Total Spending</h5>
          <p class="fs-4 fw-bold"><%= number_to_currency(@total_spent) %></p>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5>This Month</h5>
          <p class="fs-4 fw-bold"><%= number_to_currency(@month_spent) %></p>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5>Spending Change</h5>
          <p class="fs-4 fw-bold"><%= @insight_message %></p>
        </div>
      </div>
    </div>
  </div>

      <!-- Charts Row -->
  <div class="row">
    <!-- Category Pie Chart -->
    <div class="col-md-6 mb-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h4 class="card-title">Spending by Category</h4>
          <canvas id="pieChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Monthly Line Chart -->
    <div class="col-md-6 mb-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h4 class="card-title">Monthly Spending</h4>
          <canvas id="lineChart"></canvas>
        </div>
      </div>
    </div>
  </div>



</div>

<!-- Chart.js via CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    /* Pie Chart */
    const pieCtx = document.getElementById('pieChart');
    if (pieCtx) {
      new Chart(pieCtx, {
        type: 'pie',
        data: {
          labels: <%= raw @spending_by_category.keys.to_json %>,
          datasets: [{
            data: <%= raw @spending_by_category.values.to_json %>
          }]
        }
      });
    }

    /* Line Chart */
    const lineCtx = document.getElementById('lineChart');
    if (lineCtx) {
      new Chart(lineCtx, {
        type: 'line',
        data: {
          labels: <%= raw @monthly_labels.to_json %>,
          datasets: [{
            label: "Monthly Spending",
            data: <%= raw @monthly_values.to_json %>
          }]
        }
      });
    }
  });
</script>
