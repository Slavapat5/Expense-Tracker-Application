<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Expense Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

<link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
  integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
  crossorigin="anonymous">


    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
  </head>

  <body>
    <nav class="navbar">
  <div class="nav-left">
    <%= link_to "Home", root_path, class: "nav-link" %>
    <%= link_to "New Transaction", new_transaction_path, class: "nav-link" %>
    <%= link_to "My Categories", categories_path, class: "nav-link" %>
    <%= link_to "Dashboard", dashboard_path, class: "nav-link" %>

    <% if user_signed_in? %>
      <div class="dropdown">
        <button class="dropbtn">Categories ▼</button>
        <div class="dropdown-content">
          <% current_user.categories.each do |category| %>
            <%= link_to category.name, new_transaction_path(category_id: category.id) %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="nav-right">
    <% if user_signed_in? %>
      <span>Logged in as <%= current_user.email %></span>
      <%= link_to "Logout", destroy_user_session_path, method: :delete, class: "nav-link" %>
    <% else %>
      <%= link_to "Login", new_user_session_path, class: "nav-link" %>
      <%= link_to "Sign Up", new_user_registration_path, class: "nav-link" %>
    <% end %>
  </div>
</nav>


    <% if notice.present? %>
      <p class="notice"><%= notice %></p>
    <% end %>

    <% if alert.present? %>
      <p class="alert"><%= alert %></p>
    <% end %>

    <main>
      <%= yield %>
    </main>



<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
  crossorigin="anonymous"></script>

  </body>
</html>
