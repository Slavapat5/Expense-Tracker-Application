<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Expense Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
  </head>

  <body class="bg-light">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
      <div class="container">
        <a class="navbar-brand" href="<%= root_path %>">ExpenseTracker</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarContent">

          <ul class="navbar-nav me-auto mb-2 mb-lg-0">

            <% if user_signed_in? %>
              <li class="nav-item">
                <%= link_to "Dashboard", dashboard_path, class: "nav-link" %>
              </li>

              <li class="nav-item">
                <%= link_to "Transactions", transactions_path, class: "nav-link" %>
              </li>

              <li class="nav-item">
                <%= link_to "New Transaction", new_transaction_path, class: "nav-link" %>
              </li>

              <li class="nav-item">
                <%= link_to "Categories", categories_path, class: "nav-link" %>
              </li>

              <!-- Bootstrap Dropdown -->
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="categoriesDropdown" role="button"
                   data-bs-toggle="dropdown">
                  Quick Add
                </a>
                <ul class="dropdown-menu" aria-labelledby="categoriesDropdown">
                  <% current_user.categories.each do |category| %>
                    <li>
                      <%= link_to category.name,
                                  new_transaction_path(category_id: category.id),
                                  class: "dropdown-item" %>
                    </li>
                  <% end %>
                </ul>
              </li>
            <% end %>

          </ul>

          <ul class="navbar-nav">
            <% if user_signed_in? %>
              <li class="nav-item">
                <span class="navbar-text me-3">
                  Logged in as <strong><%= current_user.email %></strong>
                </span>
              </li>
              <li class="nav-item">
                <%= link_to "Logout",
                            destroy_user_session_path,
                            method: :delete,
                            class: "btn btn-outline-light btn-sm" %>
              </li>
            <% else %>
              <li class="nav-item me-2">
                <%= link_to "Login", new_user_session_path, class: "btn btn-light btn-sm" %>
              </li>
              <li class="nav-item">
                <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-warning btn-sm" %>
              </li>
            <% end %>
          </ul>

        </div>
      </div>
    </nav>

    <!-- FLASH MESSAGES -->
    <div class="container mb-3">
      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="alert alert-danger alert-dismissible fade show">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
    </div>

    <!-- MAIN CONTENT -->
    <div class="container mb-5">
      <%= yield %>
    </div>

    <!-- Bootstrap JS -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

  </body>
</html>
