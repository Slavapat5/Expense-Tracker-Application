<div id="<%= dom_id transaction %>">
  <p>
    <strong>Occurred on:</strong>
    <%= transaction.occurred_on %>
  </p>

  <p>
    <strong>Amount:</strong>
    <%= transaction.amount %>
  </p>

  <p>
    <strong>Note:</strong>
    <%= transaction.note %>
  </p>

  <p>
    <strong>Category:</strong>
    <%= transaction.category_id %>
  </p>

  <p>
    <strong>User:</strong>
    <%= transaction.user_id %>
  </p>

</div>
