<% content_for :title, "Transactions" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3">Transactions</h1>
  <%= link_to "New Transaction", new_transaction_path, class: "btn btn-primary" %>
</div>

<!-- FILTERS -->
<div class="card mb-4">
  <div class="card-body">
    <%= form_with url: transactions_path, method: :get, local: true do |form| %>

      <div class="row g-3">
        <!-- Category Filter -->
        <div class="col-md-3">
          <%= form.label :category_id, "Category", class: "form-label" %>
          <%= form.collection_select :category_id, @categories, :id, :name, 
                include_blank: "All", class: "form-select" %>
        </div>

        <!-- Date Filter -->
        <div class="col-md-3">
          <%= form.label :start_date, "From", class: "form-label" %>
          <%= form.date_field :start_date, class: "form-control" %>
        </div>

        <div class="col-md-3">
          <%= form.label :end_date, "To", class: "form-label" %>
          <%= form.date_field :end_date, class: "form-control" %>
        </div>

        <!-- Sorting -->
        <div class="col-md-3">
          <%= form.label :sort, "Sort by", class: "form-label" %>
          <%= form.select :sort, [
                ["Newest first", nil],
                ["Oldest first", "oldest"],
                ["Amount low → high", "amount_asc"],
                ["Amount high → low", "amount_desc"]
              ],
              {}, class: "form-select" %>
        </div>
      </div>

      <div class="mt-3 text-end">
        <%= form.submit "Apply Filters", class: "btn btn-secondary" %>
      </div>

    <% end %>
  </div>
</div>

<!-- TRANSACTIONS TABLE -->
<div class="card">
  <div class="card-body p-0">

    <table class="table table-striped mb-0">
      <thead class="table-light">
        <tr>
          <th>Date</th>
          <th>Amount</th>
          <th>Category</th>
          <th>Note</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>

      <tbody>
        <% @transactions.each do |transaction| %>
          <tr>
            <td><%= transaction.occurred_on %></td>
            <td><%= number_to_currency(transaction.amount) %></td>
            <td><%= transaction.category.name %></td>
            <td><%= transaction.note %></td>
            <td class="text-end">
              <%= link_to "Edit", edit_transaction_path(transaction), class: "btn btn-sm btn-outline-primary" %>
              <%= link_to "Delete", transaction,
                          method: :delete,
                          data: { confirm: "Are you sure?" },
                          class: "btn btn-sm btn-outline-danger ms-1" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

  </div>
</div>

<!-- PAGINATION -->
<div class="mt-3 d-flex justify-content-center">
  <%= paginate @transactions %>
</div>
