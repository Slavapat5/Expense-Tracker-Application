<% content_for :title, "Transaction Details" %>

<div class="col-md-8 mx-auto">

  <!-- Success Banner -->
  <% if notice.present? %>
    <div class="alert alert-success alert-dismissible fade show">
      <%= notice %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% end %>

  <!-- Transaction Card -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
      <h4 class="mb-0">Transaction Details</h4>
    </div>

    <div class="card-body">

      <p><strong>Date:</strong> <%= @transaction.occurred_on %></p>
      <p><strong>Amount:</strong> <%= number_to_currency(@transaction.amount) %></p>
      <p><strong>Category:</strong> <%= @transaction.category.name %></p>

      <% if @transaction.note.present? %>
        <p><strong>Note:</strong> <%= @transaction.note %></p>
      <% end %>

    </div>
  </div>

  <!-- Buttons -->
  <div class="d-flex justify-content-between">
    <%= link_to "Back to Transactions", transactions_path,
                class: "btn btn-outline-secondary" %>

    <div>
      <%= link_to "Edit", edit_transaction_path(@transaction),
                  class: "btn btn-warning me-2" %>

      <%= link_to "Delete",
                  @transaction,
                  method: :delete,
                  data: { confirm: "Are you sure you want to delete this transaction?" },
                  class: "btn btn-danger" %>
    </div>
  </div>

</div>
